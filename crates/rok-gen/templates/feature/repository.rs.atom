/// Persistence port for {{ feature_words }}.
///
/// The service layer depends only on this trait, never on `sqlx` or
/// [`db::PgPool`] directly. Implemented below by [`Pg{{ S }}Repository`] for
/// Postgres, and by an in-memory fake in tests.
#[async_trait]
pub trait {{ S }}Repository: Send + Sync {
    /// # Errors
    ///
    /// Returns [`{{ E }}::Repository`] on an underlying storage failure.
    async fn find_by_id(&self, id: Uuid) -> Result<Option<{{ S }}>, {{ E }}>;

    /// A page of {{ feature_words }}, oldest first. Paginates by offset (`page`/`per_page`);
    /// see `users::PgUserRepository` for cursor and keyset pagination.
    ///
    /// # Errors
    ///
    /// Returns [`{{ E }}::Repository`] on an underlying storage failure.
    async fn list(&self, query: &PaginationQuery) -> Result<Page<{{ S }}>, {{ E }}>;

    /// # Errors
    ///
    /// Returns [`{{ E }}::Repository`] on an underlying storage failure.
    async fn create(&self, new: &New{{ S }}) -> Result<{{ S }}, {{ E }}>;

    /// Returns the updated {{ s_words }}, or `None` when none exists with that id.
    ///
    /// # Errors
    ///
    /// Returns [`{{ E }}::Repository`] on an underlying storage failure.
    async fn update(&self, id: Uuid, update: &{{ S }}Update) -> Result<Option<{{ S }}>, {{ E }}>;

    /// Returns whether a {{ s_words }} with that id existed.
    ///
    /// # Errors
    ///
    /// Returns [`{{ E }}::Repository`] on an underlying storage failure.
    async fn delete(&self, id: Uuid) -> Result<bool, {{ E }}>;
}

