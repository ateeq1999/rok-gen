// Every `SELECT`/`RETURNING` below repeats the same column list literally:
// sqlx requires literal query text, so it can't be a `const` interpolated via
// `format!`. Adding a column means updating every copy the same way.

/// Postgres-backed [`{{ S }}Repository`] adapter.
#[derive(Clone)]
pub struct Pg{{ S }}Repository {
    pool: PgPool,
}

impl Pg{{ S }}Repository {
    #[must_use]
    pub const fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// Every `sqlx::Error` is an infrastructure failure by the time it reaches
/// the port; the rest of the crate only ever sees [`{{ E }}::Repository`].
// By value: it's passed to `map_err` as a function.
#[allow(clippy::needless_pass_by_value)]
fn repository_error(err: sqlx::Error) -> {{ E }} {
    {{ E }}::Repository(err.to_string())
}

#[async_trait]
impl {{ S }}Repository for Pg{{ S }}Repository {
    async fn find_by_id(&self, id: Uuid) -> Result<Option<{{ S }}>, {{ E }}> {
        let row = sqlx::query_as::<_, {{ S }}Row>(
            "SELECT {{ columns }} FROM {{ table }} WHERE id = $1",
        )
        .bind(id)
        .fetch_optional(&self.pool)
        .await
        .map_err(repository_error)?;

        Ok(row.map({{ S }}::from))
    }

    async fn list(&self, query: &PaginationQuery) -> Result<Page<{{ S }}>, {{ E }}> {
        let rows = sqlx::query_as::<_, {{ S }}Row>(
            "SELECT {{ columns }} FROM {{ table }} ORDER BY created_at, id LIMIT $1 OFFSET $2",
        )
        .bind(i64::from(query.per_page()))
        .bind(query.offset())
        .fetch_all(&self.pool)
        .await
        .map_err(repository_error)?;

        let total: i64 = sqlx::query_scalar("SELECT COUNT(*) FROM {{ table }}")
            .fetch_one(&self.pool)
            .await
            .map_err(repository_error)?;

        Ok(Page::Offset {
            items: rows.into_iter().map({{ S }}::from).collect(),
            page: query.page(),
            per_page: query.per_page(),
            total: u64::try_from(total).unwrap_or(0),
        })
    }

    async fn create(&self, new: &New{{ S }}) -> Result<{{ S }}, {{ E }}> {
        let row = sqlx::query_as::<_, {{ S }}Row>(
            "INSERT INTO {{ table }} ({{ insert_columns }}) VALUES ({{ insert_params }}) \
             RETURNING {{ columns }}",
        )
        .bind(new.id)
{%- for f in fields %}
        .bind({% if not f.copy %}&{% endif %}new.{{ f.name }})
{%- endfor %}
        .fetch_one(&self.pool)
        .await
        .map_err(repository_error)?;

        Ok(row.into())
    }

    async fn update(&self, id: Uuid, update: &{{ S }}Update) -> Result<Option<{{ S }}>, {{ E }}> {
        let row = sqlx::query_as::<_, {{ S }}Row>(
            "UPDATE {{ table }} SET {{ update_sets }} WHERE id = $1 RETURNING {{ columns }}",
        )
        .bind(id)
{%- for f in fields %}
        .bind({% if not f.base_copy %}&{% endif %}update.{{ f.name }})
{%- endfor %}
        .fetch_optional(&self.pool)
        .await
        .map_err(repository_error)?;

        Ok(row.map({{ S }}::from))
    }

    async fn delete(&self, id: Uuid) -> Result<bool, {{ E }}> {
        let result = sqlx::query("DELETE FROM {{ table }} WHERE id = $1")
            .bind(id)
            .execute(&self.pool)
            .await
            .map_err(repository_error)?;

        Ok(result.rows_affected() > 0)
    }
}

#[cfg(any(test, feature = "fake"))]
pub mod fake {
    //! An in-memory [`super::{{ S }}Repository`], so business rules are
    //! unit-tested without Postgres.

    use std::sync::{Mutex, PoisonError};

    use async_trait::async_trait;
    use chrono::Utc;
    use error::{{ E }};
    use pagination::{Page, PaginationQuery};
    use uuid::Uuid;

    use super::{{ S }}Repository;
    use crate::{{ s }}_entity::{New{{ S }}, {{ S }}, {{ S }}Update};

    /// In-memory [`{{ S }}Repository`].
    #[derive(Default)]
    pub struct Fake{{ S }}Repository {
        items: Mutex<Vec<{{ S }}>>,
    }

    #[async_trait]
    impl {{ S }}Repository for Fake{{ S }}Repository {
        async fn find_by_id(&self, id: Uuid) -> Result<Option<{{ S }}>, {{ E }}> {
            let items = self.items.lock().unwrap_or_else(PoisonError::into_inner);
            Ok(items.iter().find(|item| item.id == id).cloned())
        }

        async fn list(&self, query: &PaginationQuery) -> Result<Page<{{ S }}>, {{ E }}> {
            let items = self.items.lock().unwrap_or_else(PoisonError::into_inner);
            let skip = usize::try_from(query.offset()).unwrap_or(0);
            let take = usize::try_from(query.per_page()).unwrap_or(usize::MAX);
            Ok(Page::Offset {
                items: items.iter().skip(skip).take(take).cloned().collect(),
                page: query.page(),
                per_page: query.per_page(),
                total: u64::try_from(items.len()).unwrap_or(u64::MAX),
            })
        }

        async fn create(&self, new: &New{{ S }}) -> Result<{{ S }}, {{ E }}> {
            let item = {{ S }} {
                id: new.id,
    {%- for f in fields %}
                {{ f.name }}: new.{{ f.name }}{% if not f.copy %}.clone(){% endif %},
    {%- endfor %}
                created_at: Utc::now(),
            };
            self.items
                .lock()
                .unwrap_or_else(PoisonError::into_inner)
                .push(item.clone());
            Ok(item)
        }

        async fn update(&self, id: Uuid, update: &{{ S }}Update) -> Result<Option<{{ S }}>, {{ E }}> {
            let mut items = self.items.lock().unwrap_or_else(PoisonError::into_inner);
            let Some(item) = items.iter_mut().find(|item| item.id == id) else {
                return Ok(None);
            };
    {%- for f in fields %}
            if let Some(value) = &update.{{ f.name }} {
{%- if f.base_copy %}
                item.{{ f.name }} = {% if f.optional %}Some(*value){% else %}*value{% endif %};
{%- elif f.optional %}
                item.{{ f.name }} = Some(value.clone());
{%- else %}
                item.{{ f.name }}.clone_from(value);
{%- endif %}
            }
    {%- endfor %}
            let updated = item.clone();
            drop(items);
            Ok(Some(updated))
        }

        async fn delete(&self, id: Uuid) -> Result<bool, {{ E }}> {
            let mut items = self.items.lock().unwrap_or_else(PoisonError::into_inner);
            let before = items.len();
            items.retain(|item| item.id != id);
            Ok(items.len() < before)
        }
    }

