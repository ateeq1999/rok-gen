#[cfg(test)]
mod tests {
    use super::*;
    use crate::test_support::Fake{{ S }}Repository;

    fn service() -> {{ S }}Service {
        {{ S }}Service::new(Arc::new(Fake{{ S }}Repository::default()))
    }

    fn create_request() -> Create{{ S }}Request {
        Create{{ S }}Request {
{%- for f in fields %}
            {{ f.name }}: {{ f.sample }},
{%- endfor %}
        }
    }

    #[actix_web::test]
    async fn created_{{ s }}_can_be_read_back() {
        let service = service();
        let created = service.create(&create_request()).await.unwrap();

        let found = service.get(created.id).await.unwrap();

        assert_eq!(found.id, created.id);
    }

    #[actix_web::test]
    async fn unknown_id_is_not_found() {
        let service = service();
        let id = Uuid::new_v4();

        assert!(matches!(service.get(id).await, Err({{ E }}::NotFound(missing)) if missing == id));
        assert!(matches!(
            service.update(id, &Update{{ S }}Request::default()).await,
            Err({{ E }}::NotFound(_))
        ));
        assert!(matches!(service.delete(id).await, Err({{ E }}::NotFound(_))));
    }

    #[actix_web::test]
    async fn deleted_{{ s }}_is_gone() {
        let service = service();
        let created = service.create(&create_request()).await.unwrap();

        service.delete(created.id).await.unwrap();

        assert!(matches!(service.get(created.id).await, Err({{ E }}::NotFound(_))));
    }

    #[actix_web::test]
    async fn list_pages_by_offset() {
        let service = service();
        for _ in 0..3 {
            service.create(&create_request()).await.unwrap();
        }

        let page = service.list(&PaginationQuery::default()).await.unwrap();

        assert!(matches!(page, Page::Offset { ref items, total: 3, .. } if items.len() == 3));
    }
}
