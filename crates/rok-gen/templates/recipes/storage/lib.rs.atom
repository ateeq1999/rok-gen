#[cfg(any(test, feature = "fake"))]
pub mod fake {
    //! An in-memory [`Storage`](super::Storage).

    use std::collections::HashMap;
    use std::sync::{Mutex, PoisonError};

    use async_trait::async_trait;

    use super::{Storage, StorageError, check_key};

    #[derive(Default)]
    pub struct FakeStorage {
        objects: Mutex<HashMap<String, Vec<u8>>>,
    }

    #[async_trait]
    impl Storage for FakeStorage {
        async fn put(&self, key: &str, bytes: Vec<u8>) -> Result<(), StorageError> {
            check_key(key)?;
            self.objects
                .lock()
                .unwrap_or_else(PoisonError::into_inner)
                .insert(key.to_string(), bytes);
            Ok(())
        }

        async fn get(&self, key: &str) -> Result<Option<Vec<u8>>, StorageError> {
            check_key(key)?;
            Ok(self
                .objects
                .lock()
                .unwrap_or_else(PoisonError::into_inner)
                .get(key)
                .cloned())
        }

        async fn delete(&self, key: &str) -> Result<(), StorageError> {
            check_key(key)?;
            self.objects
                .lock()
                .unwrap_or_else(PoisonError::into_inner)
                .remove(key);
            Ok(())
        }
    }
}

#[cfg(test)]
mod tests {
    use super::fake::FakeStorage;
    use super::{Storage, check_key};

    #[test]
    fn keys_cannot_escape_the_store() {
        assert!(check_key("avatars/42.png").is_ok());
        for key in ["", "/etc/passwd", "../secret", "a/../../b", "a//b"] {
            assert!(check_key(key).is_err(), "{key}");
        }
    }

    #[tokio::test]
    async fn the_fake_round_trips_objects() {
        let storage = FakeStorage::default();

        storage.put("a/b.txt", b"hello".to_vec()).await.ok();
        let stored = storage.get("a/b.txt").await.ok().flatten();
        storage.delete("a/b.txt").await.ok();

        assert_eq!(stored.as_deref(), Some(&b"hello"[..]));
        assert_eq!(storage.get("a/b.txt").await.ok().flatten(), None);
    }
}
