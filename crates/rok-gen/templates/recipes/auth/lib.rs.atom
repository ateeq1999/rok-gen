//! Authentication with the `{{ driver }}` driver, plus verification email
//! through the `mail` recipe.
//!
//! Added by `cargo rok add auth --driver {{ driver }}` (recipe version
//! {{ version }}).

use thiserror::Error;
use uuid::Uuid;

/// Why authentication failed.
#[derive(Debug, Error)]
pub enum AuthError {
    #[error("environment variable {0} is not set")]
    MissingEnv(&'static str),
    #[error("invalid auth configuration: {0}")]
    Config(String),
    #[error("not authenticated")]
    Unauthenticated,
}

fn env(key: &'static str) -> Result<String, AuthError> {
    std::env::var(key).map_err(|_| AuthError::MissingEnv(key))
}
{% if driver == "session" %}
use actix_session::config::PersistentSession;
use actix_session::storage::CookieSessionStore;
use actix_session::{Session, SessionMiddleware};
use actix_web::cookie::Key;

/// The session key holding the signed-in user's id.
const USER_ID: &str = "user_id";

/// Cookie sessions signed and encrypted with `SESSION_SECRET` (at least 64
/// bytes). Wrap the app with it in the composition root.
///
/// # Errors
///
/// [`AuthError::MissingEnv`] when it's unset, [`AuthError::Config`] when
/// it's too short.
pub fn session_middleware() -> Result<SessionMiddleware<CookieSessionStore>, AuthError> {
    let secret = env("SESSION_SECRET")?;
    if secret.len() < 64 {
        return Err(AuthError::Config(
            "SESSION_SECRET must be at least 64 bytes".to_string(),
        ));
    }
    Ok(
        SessionMiddleware::builder(CookieSessionStore::default(), Key::from(secret.as_bytes()))
            .session_lifecycle(PersistentSession::default())
            .build(),
    )
}

/// Signs `user_id` in, replacing the session (and its id) to prevent
/// session fixation.
///
/// # Errors
///
/// [`AuthError::Config`] when the session can't be written.
pub fn sign_in(session: &Session, user_id: Uuid) -> Result<(), AuthError> {
    session.renew();
    session
        .insert(USER_ID, user_id)
        .map_err(|err| AuthError::Config(err.to_string()))
}

/// The signed-in user's id.
///
/// # Errors
///
/// [`AuthError::Unauthenticated`] when nobody is signed in.
pub fn current_user(session: &Session) -> Result<Uuid, AuthError> {
    session
        .get::<Uuid>(USER_ID)
        .ok()
        .flatten()
        .ok_or(AuthError::Unauthenticated)
}

/// Signs the current user out.
pub fn sign_out(session: &Session) {
    session.purge();
}
