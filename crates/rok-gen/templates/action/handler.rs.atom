
/// `{{ method_upper }} {{ full_path }}`. Generated by `cargo rok make:action`:
/// replace the body with a call into the feature's service, and update the
/// documented responses to match.
#[utoipa::path(
    {{ method }},
    path = "{{ full_path }}",
    tag = "{{ tag }}",
{%- if guarded %}
    security(("bearer_auth" = [])),
{%- endif %}
{%- if path_params %}
    params(
{%- for p in path_params %}
        ("{{ p.name }}" = {{ p.ty }}, Path, description = "{{ p.name }}"),
{%- endfor %}
    ),
{%- endif %}
{%- if body %}
    request_body = {{ body }},
{%- endif %}
    responses(
        (status = 501, description = "Not implemented yet"),
{%- if body %}
        (status = 400, description = "Request validation failed"),
{%- endif %}
{%- if guarded %}
        (status = 401, description = "Missing or invalid authorization token"),
{%- endif %}
{%- if admin %}
        (status = 403, description = "Caller is authenticated but not an admin"),
{%- endif %}
    ),
)]
#[{{ method }}("{{ path }}")]
pub async fn {{ name }}(
{%- if path_params %}
    _path: web::Path<{{ path_type }}>,
{%- endif %}
{%- if body %}
    _body: ValidatedJson<{{ body }}>,
{%- endif %}
{%- if admin %}
    _admin: AdminUser,
{%- endif %}
) -> HttpResponse {
    HttpResponse::NotImplemented().finish()
}
