{%- if has_date %}
use chrono::NaiveDate;
{%- endif %}
{%- if has_datetime_field %}
use chrono::{DateTime, Utc};
{%- endif %}
{%- if request %}
use serde::Deserialize;
{%- else %}
use serde::Serialize;
{%- endif %}
use utoipa::ToSchema;
{%- if has_uuid_field %}
use uuid::Uuid;
{%- endif %}
{%- if request %}
use validator::Validate;
{%- endif %}

/// Generated by `cargo rok make:dto`.
{%- if request %}
#[derive(Clone, Debug, Deserialize, Validate, ToSchema)]
{%- else %}
#[derive(Clone, Debug, Serialize, ToSchema)]
{%- endif %}
pub struct {{ name }} {
{%- for f in fields %}
{%- if request and f.optional %}
    #[serde(default)]
{%- endif %}
{%- if request and f.is_string %}
    #[validate(length(min = 1, message = "{{ f.name }} cannot be blank"))]
{%- endif %}
    pub {{ f.name }}: {{ f.ty }},
{%- endfor %}
}
