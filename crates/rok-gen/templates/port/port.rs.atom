use async_trait::async_trait;
{%- for path in uses %}
use {{ path }};
{%- endfor %}

/// A port `{{ target }}` owns and another feature implements (generated by
/// the `port` strategy of `cargo rok integrate`), so `{{ target }}` can call
/// it without depending on that feature's crate.
#[async_trait]
pub trait {{ port }}: Send + Sync {
{%- for method in methods %}
{%- for line in method.doc %}
    ///{% if line %} {{ line }}{% endif %}
{%- endfor %}
    {{ method.signature }};
{%- endfor %}
}

#[cfg(any(test, feature = "fake"))]
pub mod fake {
    //! An in-memory [`super::{{ port }}`] for `{{ target }}`'s own tests.

    // The port, `async_trait` and whatever the signatures name.
    #[allow(clippy::wildcard_imports)]
    use super::*;

    // Braced, not a unit struct: callers build it with `default()`.
    #[derive(Default)]
    pub struct Fake{{ port }} {}

    #[async_trait]
    impl {{ port }} for Fake{{ port }} {
{%- for method in methods %}
        {{ method.signature }} {
            {{ method.fake }}
        }
{%- endfor %}
    }
}
