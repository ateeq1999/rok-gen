{
  "name": "{{ source }} into {{ target }}",
  "steps": [
    {
      "op": "add_method",
      "file": "{{ source }}/repository",
      "trait": "{{ Source }}Repository",
      "signature": "async fn on_{{ target_s }}_{{ on }}(&self, {{ target_s }}_id: Uuid) -> Result<(), {{ SourceE }}>",
      "doc": [
        "Called by `{{ Target }}Service::{{ on }}` before it writes. Generated by the",
        "`hook` preset as a no-op: record what this feature needs here.",
        "",
        "# Errors",
        "",
        "Returns [`{{ SourceE }}::Repository`] on an underlying storage failure."
      ],
      "bodies": {
        "Pg{{ Source }}Repository": "let _ = (&self.pool, {{ target_s }}_id);\nOk(())",
        "Fake{{ Source }}Repository": "let _ = {{ target_s }}_id;\nOk(())"
      }
    },
    {
      "op": "inject_dependency",
      "into": "{{ target }}/service",
      "service": "{{ Target }}Service",
      "dep": "{{ source }}::{{ Source }}Repository",
      "as": "{{ source }}"
    },
    {
      "op": "insert",
      "at": {
        "file": "{{ target }}/service",
        "fn": "{{ Target }}Service::{{ on }}",
{%- if on == "create" %}
        "before": { "index": "tail" }
{%- else %}
        "start": true
{%- endif %}
      },
      "code": "self.{{ source }}\n    .on_{{ target_s }}_{{ on }}({{ id_expr }})\n    .await\n    .map_err(|err| {{ TargetE }}::Repository(err.to_string()))?;"
    }
  ]
}
